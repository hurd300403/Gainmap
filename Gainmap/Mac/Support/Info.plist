<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Gainmap</string>
    <key>CFBundleDisplayName</key>
    <string>Gainmap</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Apple, Google, and Patreon OAuth return through an active
         ASWebAuthenticationSession. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>gainmapauth</string>
                <string>com.googleusercontent.apps.937169591841-ibfut223q9cfsta6nr0hkv280bks0d3j</string>
            </array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.photography</string>
    <key>NSHumanReadableCopyright</key>
    <string>© Legacy Lab. Built on libultrahdr (Apache-2.0) and libjpeg-turbo.</string>
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
    <!-- Sparkle auto-update -->
    <key>SUFeedURL</key>
    <string>https://github.com/hurd300403/Gainmap/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>OntsKfVJZEgyfDqAhxG/y4JQ76fklmyC7ifzGbghAew=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- Sentry crash reporting. DSN is injected at build time via $(SENTRY_DSN);
         empty in dev builds => the SDK is a silent no-op. A DSN is not a secret
         (ingest-only public key). -->
    <key>SentryDSN</key>
    <string>$(SENTRY_DSN)</string>
    <!-- Remote version gate ("disable old versions"). The app fetches this on
         launch and blocks only if its build is below the minimum; fails OPEN on
         any network/parse error so it can never strand an offline user. -->
    <key>GainmapGateURL</key>
    <string>https://samhurdphotography.com/gainmap/gate.json</string>
</dict>
</plist>
